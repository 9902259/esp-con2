# Keep downloaded tools and generated builds out of source control.
.deps/
.venv/
__pycache__/
# Direct idf.py runs outside scripts/idf.sh write config and builds in-tree.
firmware/**/build/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
# Outputs left by older checkouts before builds moved under build/.
firmware/build-*/
firmware/sdkconfig-*
bin/
.playwright-cli/
# Generated output and local recovery images are never project source.
build/
backups/

# JavaScript dependencies are restored from the lockfile.
node_modules/

# macOS file metadata is not project source.
.DS_Store
